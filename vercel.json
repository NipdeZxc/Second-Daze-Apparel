{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci && npm --prefix react_frontend ci",
  "buildCommand": "npm --prefix react_frontend run build",
  "outputDirectory": "react_frontend/dist",
  "rewrites": [
    { "source": "/mobile", "destination": "/index.html" },
    { "source": "/mobile/", "destination": "/index.html" }
  ]
}
